{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cb_rgb",
  "version": "0.1.0",
  "identifier": "in.sipusumit.cosmicontroller",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cb_rgb",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux" :{
      "deb": {
        "files": {
          "/etc/udev/rules.d/99-cosmicbyte.rules": "rules/99-cosmicbyte.rules"
        },
        "postInstallScript": "scripts/postinst",
        "postRemoveScript": "scripts/postrm"
      }
    }
  }
}
